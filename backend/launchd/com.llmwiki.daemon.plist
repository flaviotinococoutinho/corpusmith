<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.llmwiki.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BACKEND__/.venv/bin/python</string>
        <string>-m</string>
        <string>llmwiki.daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/llmwiki/logs/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/llmwiki/logs/daemon.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
